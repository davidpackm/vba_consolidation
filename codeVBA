Option Explicit

' ========================================
' MODULE 1 : Phase 1 - Vérification de structure
' ========================================

Public Sub VerifierStructure()
    Dim ws As Worksheet
    Dim lastCol As Long, lastRow As Long
    Dim colNames As Variant
    Dim i As Long, colIndex As Long
    Dim msg As String
    Dim hasError As Boolean
    Dim c As Range
    Dim nbErreurs As Long
    
    ' Vérifier que la feuille existe
    On Error Resume Next
    Set ws = ThisWorkbook.Worksheets("Données")
    On Error GoTo 0
    
    If ws Is Nothing Then
        MsgBox "La feuille 'Données' n'existe pas !" & vbCrLf & _
               "Veuillez créer une feuille nommée 'Données' avec vos données.", _
               vbCritical, "Erreur"
        Exit Sub
    End If
    
    ' Noms de colonnes obligatoires
    colNames = Array("Hôpital", "Spécialité", "Durée_Séjour(jours)", "Coût(€)", "Date_Entrée", "Sexe")
    
    lastCol = ws.Cells(1, ws.Columns.Count).End(xlToLeft).Column
    lastRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).row
    
    ' Vérifier qu'il y a au moins une ligne d'en-tête
    If lastRow < 1 Then
        MsgBox "La feuille 'Données' est vide !", vbCritical, "Erreur"
        Exit Sub
    End If
    
    ' Nettoyer anciens formats (fond)
    ws.Cells.Interior.ColorIndex = xlNone
    
    msg = ""
    hasError = False
    nbErreurs = 0
    
    ' ========================================
    ' 1) Vérifier présence des colonnes obligatoires
    ' ========================================
    
    For i = LBound(colNames) To UBound(colNames)
        colIndex = TrouverColonne(ws, CStr(colNames(i)))
        If colIndex = 0 Then
            msg = msg & "- Colonne manquante : " & colNames(i) & vbCrLf
            hasError = True
            nbErreurs = nbErreurs + 1
        End If
    Next i
    
    ' Si colonnes manquantes, on signale et on arrête
    If hasError Then
        MsgBox "Structure NON conforme :" & vbCrLf & vbCrLf & msg & vbCrLf & _
               "Nombre d'anomalies : " & nbErreurs, _
               vbCritical, "Vérification structure"
        Exit Sub
    End If
    
    ' ========================================
    ' 2) Vérifier les formats des colonnes
    ' ========================================
    
    Dim colDate As Long, colDuree As Long, colCout As Long
    
    colDate = TrouverColonne(ws, "Date_Entrée")
    colDuree = TrouverColonne(ws, "Durée_Séjour(jours)")
    colCout = TrouverColonne(ws, "Coût(€)")
    
    ' Réinitialiser le compteur d'erreurs
    nbErreurs = 0
    msg = ""
    
    ' Boucle sur les lignes de données
    For i = 2 To lastRow
        
        ' Date_Entrée doit être une date valide
        Set c = ws.Cells(i, colDate)
        If Not IsEmpty(c.Value) Then
            If Not IsDate(c.Value) Then
                c.Interior.Color = vbRed
                msg = msg & "Ligne " & i & " : Date_Entrée invalide" & vbCrLf
                hasError = True
                nbErreurs = nbErreurs + 1
            End If
        Else
            ' Date manquante
            c.Interior.Color = vbRed
            msg = msg & "Ligne " & i & " : Date_Entrée manquante" & vbCrLf
            hasError = True
            nbErreurs = nbErreurs + 1
        End If
        
        ' Durée_Séjour doit être numérique
        Set c = ws.Cells(i, colDuree)
        If Not IsEmpty(c.Value) Then
            If Not IsNumeric(c.Value) Then
                c.Interior.Color = vbRed
                msg = msg & "Ligne " & i & " : Durée_Séjour non numérique" & vbCrLf
                hasError = True
                nbErreurs = nbErreurs + 1
            End If
        End If
        
        ' Coût doit être numérique
        Set c = ws.Cells(i, colCout)
        If Not IsEmpty(c.Value) Then
            If Not IsNumeric(c.Value) Then
                c.Interior.Color = vbRed
                msg = msg & "Ligne " & i & " : Coût non numérique" & vbCrLf
                hasError = True
                nbErreurs = nbErreurs + 1
            End If
        End If
        
    Next i
    
    ' ========================================
    ' 3) Message final
    ' ========================================
    
    If hasError Then
        MsgBox "Structure vérifiée : " & nbErreurs & " anomalie(s) détectée(s)." & vbCrLf & _
               "Les cellules problématiques sont colorées en rouge." & vbCrLf & vbCrLf & _
               "Détails :" & vbCrLf & msg, _
               vbExclamation, "Vérification structure"
    Else
        MsgBox "? Structure conforme !" & vbCrLf & vbCrLf & _
               "Toutes les colonnes obligatoires sont présentes et les formats sont corrects." & vbCrLf & _
               "Nombre de lignes vérifiées : " & (lastRow - 1), _
               vbInformation, "Vérification structure"
    End If
    
End Sub

' ========================================
' FONCTION UTILITAIRE : TrouverColonne (AMÉLIORÉE)
' ========================================
' Cette fonction recherche une colonne par son nom de manière flexible
' Elle gère les différences de casse, espaces et caractères spéciaux

Public Function TrouverColonne(ws As Worksheet, nomColonne As String) As Long
    Dim c As Range
    Dim valeurCellule As String
    Dim nomRecherche As String
    Dim lastCol As Long
    
    ' Normaliser le nom recherché (majuscules, sans espaces au début/fin)
    nomRecherche = UCase(Trim(nomColonne))
    
    ' Déterminer la dernière colonne pour limiter la recherche
    lastCol = ws.Cells(1, ws.Columns.Count).End(xlToLeft).Column
    If lastCol > 50 Then lastCol = 50  ' Limiter à 50 colonnes max pour performance
    
    ' Parcourir les en-têtes de colonnes (ligne 1)
    For Each c In ws.Range(ws.Cells(1, 1), ws.Cells(1, lastCol))
        If Not IsEmpty(c.Value) Then
            ' Normaliser la valeur de la cellule
            valeurCellule = UCase(Trim(CStr(c.Value)))
            
            ' Comparaison exacte d'abord
            If valeurCellule = nomRecherche Then
                TrouverColonne = c.Column
                Exit Function
            End If
            
            ' Comparaison flexible : chercher par mot-clé principal
            ' Pour gérer les variations comme "Durée_Séjour(jours)" vs "Durée_Séjour (jours)"
            If InStr(valeurCellule, nomRecherche) > 0 Then
                TrouverColonne = c.Column
                Exit Function
            End If
            
            ' Comparaison par mots-clés spécifiques
            If RechercheParMotCle(valeurCellule, nomRecherche) Then
                TrouverColonne = c.Column
                Exit Function
            End If
        End If
    Next c
    
    ' Si aucune colonne trouvée
    TrouverColonne = 0
    
End Function

' ========================================
' FONCTION AUXILIAIRE : RechercheParMotCle
' ========================================
' Recherche intelligente par mots-clés pour gérer les variations de nommage

Private Function RechercheParMotCle(valeurCellule As String, nomRecherche As String) As Boolean
    
    RechercheParMotCle = False
    
    ' Nettoyer les chaînes (enlever espaces, underscores, parenthèses)
    Dim val As String, nom As String
    val = Replace(valeurCellule, "_", "")
    val = Replace(val, " ", "")
    val = Replace(val, "(", "")
    val = Replace(val, ")", "")
    
    nom = Replace(nomRecherche, "_", "")
    nom = Replace(nom, " ", "")
    nom = Replace(nom, "(", "")
    nom = Replace(nom, ")", "")
    
    ' Comparaison après nettoyage
    If val = nom Then
        RechercheParMotCle = True
        Exit Function
    End If
    
    ' Recherche par mots-clés spécifiques pour les colonnes courantes
    Select Case True
        ' Colonne Hôpital
        Case InStr(nom, "HOPITAL") > 0 Or InStr(nom, "HÔPITAL") > 0
            If InStr(val, "HOPITAL") > 0 Or InStr(val, "HÔPITAL") > 0 Then
                RechercheParMotCle = True
            End If
            
        ' Colonne Spécialité
        Case InStr(nom, "SPECIAL") > 0 Or InStr(nom, "SPÉCIAL") > 0
            If InStr(val, "SPECIAL") > 0 Or InStr(val, "SPÉCIAL") > 0 Then
                RechercheParMotCle = True
            End If
            
        ' Colonne Durée
        Case InStr(nom, "DUREE") > 0 Or InStr(nom, "DURÉE") > 0
            If InStr(val, "DUREE") > 0 Or InStr(val, "DURÉE") > 0 Or InStr(val, "SEJOUR") > 0 Or InStr(val, "SÉJOUR") > 0 Then
                RechercheParMotCle = True
            End If
            
        ' Colonne Coût
        Case InStr(nom, "COUT") > 0 Or InStr(nom, "COÛT") > 0
            If InStr(val, "COUT") > 0 Or InStr(val, "COÛT") > 0 Then
                RechercheParMotCle = True
            End If
            
        ' Colonne Date
        Case InStr(nom, "DATE") > 0
            If InStr(val, "DATE") > 0 Or InStr(val, "ENTREE") > 0 Or InStr(val, "ENTRÉE") > 0 Then
                RechercheParMotCle = True
            End If
            
        ' Colonne Sexe
        Case InStr(nom, "SEXE") > 0
            If InStr(val, "SEXE") > 0 Or InStr(val, "GENRE") > 0 Then
                RechercheParMotCle = True
            End If
    End Select
    
End Function

